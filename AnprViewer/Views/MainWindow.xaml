<Window x:Class="AnprViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AnprViewer.Converters"
        xmlns:vm="clr-namespace:AnprViewer.ViewModels"
        xmlns:ctrl="clr-namespace:AnprViewer.Controls"
        Title="Gestor Matrículas Extendida"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Width="1400" Height="850"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:ConfidenceToWidthConverter       x:Key="ConfWidth"/>
        <conv:ConfidenceToBrushConverter       x:Key="ConfBrush"/>
        <conv:BadgeClassToBrushConverter       x:Key="BadgeFg"/>
        <conv:BadgeClassToBrushConverter       x:Key="BadgeBg" Background="True"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Resources/Images/logo.png"
                           Height="30"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="1" Height="28"
                            Background="{StaticResource Line}"
                            Margin="14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gestor Matrículas Extendida"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource Text0}"/>
                        <TextBlock Text="HISTÓRICO · TABLA HISTORICO"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11" Foreground="{StaticResource Text2}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Botón exportar listado a PDF -->
                    <Button Style="{StaticResource BtnGhost}"
                            Command="{Binding ExportToPdfCommand}"
                            ToolTip="Exportar listado actual a PDF"
                            Margin="0,0,12,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Exportar PDF" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Ok}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ConnectionLabel}"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{StaticResource Text1}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Text3}" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{StaticResource Text1}">
                                <Run Text="{Binding TotalRecords, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" registros"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTROS -->
        <Border Grid.Row="1" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MATRÍCULA" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding PlateFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="RANGO DE FECHAS" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Bg2}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        Style="{StaticResource InputDate}"
                                        SelectedDate="{Binding FromDate}"
                                        BorderThickness="0"
                                        Background="Transparent"/>
                            <TextBlock Grid.Column="1"
                                       Text="→"
                                       Foreground="{StaticResource Text3}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <DatePicker Grid.Column="2"
                                        Style="{StaticResource InputDate}"
                                        SelectedDate="{Binding ToDate}"
                                        BorderThickness="0"
                                        Background="Transparent"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="MOVIMIENTO" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding TypeFilter, Mode=TwoWay}">
                        <ComboBoxItem Tag="" Content="Todos"/>
                        <ComboBoxItem Tag="entrada"    Content="Entrada"/>
                        <ComboBoxItem Tag="salida"     Content="Salida"/>
                        <ComboBoxItem Tag="paso"       Content="Paso"/>
                        <ComboBoxItem Tag="facial"     Content="Facial"/>
                        <ComboBoxItem Tag="ciclomotor" Content="Ciclomotor"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="TERMINAL" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding TerminalFilter, Mode=TwoWay}">
                        <ComboBoxItem Tag="" Content="Todos"/>
                        <ComboBoxItem Tag="frontal" Content="Frontal"/>
                        <ComboBoxItem Tag="trasera" Content="Trasera"/>
                        <ComboBoxItem Tag="facial"  Content="Facial"/>
                        <ComboBoxItem Tag="moto"    Content="Ciclomotor"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="FIAB. MÍN." Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding MinConfidence, Mode=TwoWay}">
                        <ComboBoxItem Tag="0"  Content="0%"/>
                        <ComboBoxItem Tag="50" Content="50%"/>
                        <ComboBoxItem Tag="75" Content="75%"/>
                        <ComboBoxItem Tag="90" Content="90%"/>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="10" Style="{StaticResource BtnGhost}"
                        Content="Limpiar" VerticalAlignment="Bottom"
                        Command="{Binding ClearFiltersCommand}"/>
            </Grid>
        </Border>

        <!-- META BAR -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="18,8">
                <TextBlock Foreground="{StaticResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11">
                    <Run Text="Resultados · "/>
                    <Run Text="{Binding TotalRecords, StringFormat=N0, Mode=OneWay}" Foreground="{StaticResource Text0}"/>
                    <Run Text=" registros · página "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" Foreground="{StaticResource Text0}"/>
                    <Run Text=" de "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" Foreground="{StaticResource Text0}"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11">
                    <Run Text="{Binding QueryTimeMs, Mode=OneWay}"/>
                    <Run Text=" ms"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="Grid"
                      Style="{StaticResource GridStyle}"
                      CellStyle="{StaticResource GridCell}"
                      RowStyle="{StaticResource GridRow}"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      MouseDoubleClick="OnRowDoubleClick">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="80" SortMemberPath="NumeroLinea">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NumeroLinea, StringFormat={}{0:D6}}"
                                           Foreground="{StaticResource Text3}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Matrícula" Width="150" SortMemberPath="Plate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlateFormatted}"
                                           Foreground="{StaticResource Text0}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Fiab." Width="100" SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="4" CornerRadius="2"
                                            Background="{StaticResource Bg3}" Margin="0,0,8,0">
                                        <Border HorizontalAlignment="Left"
                                                Height="4" CornerRadius="2"
                                                Width="{Binding Confidence, Converter={StaticResource ConfWidth}, ConverterParameter=40}"
                                                Background="{Binding Confidence, Converter={StaticResource ConfBrush}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"
                                               Foreground="{StaticResource Text1}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Fecha / Hora" Width="180" SortMemberPath="FHGeneracion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DayText}"
                                               Foreground="{StaticResource Text0}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                    <TextBlock Text="{Binding TimeText}" Margin="6,0,0,0"
                                               Foreground="{StaticResource Text2}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Movimiento" Width="130" SortMemberPath="Movimiento">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        Background="{Binding MovementClass, Converter={StaticResource BadgeBg}}"
                                        BorderBrush="{Binding MovementClass, Converter={StaticResource BadgeFg}}">
                                    <TextBlock Text="{Binding Movimiento}"
                                               Foreground="{Binding MovementClass, Converter={StaticResource BadgeFg}}"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Terminal" Width="160" SortMemberPath="Terminal">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Terminal}"
                                           Foreground="{StaticResource Text1}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tarjeta" Width="120" SortMemberPath="Tarjeta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tarjeta}"
                                           Foreground="{StaticResource Text2}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Imagen" Width="80" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="58" Height="40" CornerRadius="3"
                                        Background="{StaticResource Bg2}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Loaded="OnThumbnailLoaded">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        <TextBlock Text="?"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Text3}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Visibility="{Binding HasAnyImage, Converter={StaticResource InvBoolVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones: Ver, Copiar, Exportar PDF (registro individual) -->
                    <DataGridTemplateColumn Header="Acciones" Width="*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconBtn}"
                                            Click="OnOpenViewerClick"
                                            ToolTip="Ver detalle (Doble click)">
                                        <TextBlock Text="◉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Click="OnCopyPlateClick"
                                            ToolTip="Copiar matrícula">
                                        <TextBlock Text="⧉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ExportSelectedRecordPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Exportar este registro a PDF (con imágenes)">
                                        <TextBlock Text="📄" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                                 Background="{StaticResource Bg2}"
                                 Foreground="{StaticResource Accent}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0"
                               Foreground="{StaticResource Text2}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PAGINACIÓN -->
        <Border Grid.Row="4" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="18,10">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="POR PÁGINA" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              MinWidth="80" Margin="0,0,12,0"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding PageSize, Mode=TwoWay}">
                        <ComboBoxItem Tag="50" Content="50"/>
                        <ComboBoxItem Tag="100" Content="100"/>
                        <ComboBoxItem Tag="250" Content="250"/>
                        <ComboBoxItem Tag="500" Content="500"/>
                    </ComboBox>

                    <Button Style="{StaticResource IconBtn}" Margin="0,0,4,0"
                            Command="{Binding FirstPageCommand}" Content="«" ToolTip="Primera"/>
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0"
                            Command="{Binding PrevPageCommand}"  Content="‹" ToolTip="Anterior"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Text0}"
                               FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,0,8,0">
                        <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,4,0"
                            Command="{Binding NextPageCommand}" Content="›" ToolTip="Siguiente"/>
                    <Button Style="{StaticResource IconBtn}"
                            Command="{Binding LastPageCommand}" Content="»" ToolTip="Última"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
