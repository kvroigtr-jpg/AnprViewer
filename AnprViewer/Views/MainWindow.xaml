<Window x:Class="AnprViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AnprViewer.Converters"
        xmlns:svc="clr-namespace:AnprViewer.Services"
        xmlns:vm="clr-namespace:AnprViewer.ViewModels"
        xmlns:ctrl="clr-namespace:AnprViewer.Controls"
        Title="Gestor Matrículas Extendido"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Width="1400" Height="850"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource Bg0}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:NullToVisibilityConverter        x:Key="NullVis"/>
        <conv:ConfidenceToWidthConverter       x:Key="ConfWidth"/>
        <conv:ConfidenceToBrushConverter       x:Key="ConfBrush"/>
        <conv:BadgeClassToBrushConverter       x:Key="BadgeFg"/>
        <conv:BadgeClassToBrushConverter       x:Key="BadgeBg" Background="True"/>
        <conv:ThemeLogoConverter               x:Key="ThemeLogo"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Border Grid.Row="0" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <StackPanel Orientation="Horizontal">
                    <Image Height="30"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Version, Source={x:Static svc:ThemeService.Instance},
                                            Converter={StaticResource ThemeLogo}}"/>
                    <Border Width="1" Height="28"
                            Background="{DynamicResource Line}"
                            Margin="14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gestor Matrículas Extendido"
                                   FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource Text0}"/>
                        <TextBlock FontFamily="{StaticResource FontMono}"
                                   FontSize="11" Foreground="{DynamicResource Text2}">
                            <Run Text="MODO ACTUAL ·"/>
                            <Run Text="{Binding ModoVistaActual, Mode=OneWay}"
                                 Foreground="{DynamicResource Accent}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Refrescar -->
                    <Button Style="{StaticResource BtnGhost}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refrescar datos (F5)"
                            Margin="0,0,8,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Refrescar" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Cambiar conexión -->
                    <Button Style="{StaticResource BtnGhost}"
                            Command="{Binding ChangeConnectionCommand}"
                            ToolTip="Cambiar conexión a otra BD"
                            Margin="0,0,8,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Cambiar conexión" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Exportar PDF listado -->
                    <Button Style="{StaticResource BtnGhost}"
                            Command="{Binding ExportToPdfCommand}"
                            ToolTip="Exportar listado actual a PDF"
                            Margin="0,0,12,0"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Exportar PDF" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Ok}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ConnectionLabel}"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{DynamicResource Text1}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Text3}" Margin="0,0,6,0"/>
                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{DynamicResource Text1}">
                                <Run Text="{Binding TotalRecords, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text=" registros"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ⚙ ENGRANAJE (settings) restaurado -->
                    <ToggleButton x:Name="SettingsToggle"
                                  Width="34" Height="34"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource Line}"
                                  BorderThickness="1"
                                  Foreground="{DynamicResource Text1}"
                                  Cursor="Hand"
                                  ToolTip="Configuración">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                    <TextBlock Text="⚙"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="root" Property="Background" Value="{DynamicResource AccentBg}"/>
                                        <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="root" Property="Background" Value="{DynamicResource AccentBg}"/>
                                        <Setter TargetName="root" Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=SettingsToggle}"
                           Placement="Bottom"
                           HorizontalOffset="-220"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}">
                        <Border Background="{DynamicResource Bg1}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Width="260"
                                Padding="14">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="CONFIGURACIÓN"
                                           Foreground="{DynamicResource Text2}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="Tema"
                                           Foreground="{DynamicResource Text1}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>

                                <Border Background="{DynamicResource Bg2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RbDark"
                                                     Grid.Column="0"
                                                     GroupName="Theme"
                                                     Content="🌙  Oscuro"
                                                     Padding="0,7"
                                                     HorizontalContentAlignment="Center"
                                                     Foreground="{DynamicResource Text1}"
                                                     Click="OnThemeDarkClick"/>
                                        <RadioButton x:Name="RbLight"
                                                     Grid.Column="1"
                                                     GroupName="Theme"
                                                     Content="☀  Claro"
                                                     Padding="0,7"
                                                     HorizontalContentAlignment="Center"
                                                     Foreground="{DynamicResource Text1}"
                                                     Click="OnThemeLightClick"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="El cambio se aplica al instante en toda la app."
                                           Foreground="{DynamicResource Text3}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════ SELECTOR DE VISTA ═════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="18,8" HorizontalAlignment="Left">

                <Button Command="{Binding SwitchViewCommand}"
                        CommandParameter="Historico"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Padding="16,8"
                        BorderThickness="1"
                        ToolTip="Mostrar histórico de movimientos">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"   Value="{DynamicResource Bg2}"/>
                            <Setter Property="BorderBrush"  Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground"   Value="{DynamicResource Text1}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoricoMode}" Value="True">
                                    <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Históricos"
                                   FontFamily="{StaticResource FontMono}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SwitchViewCommand}"
                        CommandParameter="Presentes"
                        Cursor="Hand"
                        Padding="16,8"
                        BorderThickness="1"
                        ToolTip="Mostrar vehículos actualmente en el parking">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"   Value="{DynamicResource Bg2}"/>
                            <Setter Property="BorderBrush"  Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground"   Value="{DynamicResource Text1}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPresentesMode}" Value="True">
                                    <Setter Property="Background"  Value="{DynamicResource AccentBg}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚗" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Presentes"
                                   FontFamily="{StaticResource FontMono}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- FILTROS -->
        <Border Grid.Row="2" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Fila 1: Matrícula + Rango fecha/hora preciso ── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MATRÍCULA" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding PlateFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DESDE (FECHA · HORA)" Style="{StaticResource FieldLabel}"/>
                        <ctrl:DateTimePicker SelectedDateTime="{Binding FromDate, Mode=TwoWay}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="→"
                               VerticalAlignment="Bottom" Margin="0,0,0,8"
                               Foreground="{DynamicResource Text3}"
                               FontFamily="{StaticResource FontMono}" FontSize="16"/>

                    <StackPanel Grid.Column="4" Margin="22,0,0,0">
                        <TextBlock Text="HASTA (FECHA · HORA)" Style="{StaticResource FieldLabel}"/>
                        <ctrl:DateTimePicker SelectedDateTime="{Binding ToDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- ── Fila 2: Movimiento + Terminal dinámico + Fiab + Limpiar ── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MOVIMIENTO → TipoTerminal (0/1/2) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MOVIMIENTO" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding MovimientoTipo, Mode=TwoWay}">
                            <ComboBoxItem Tag="" Content="Todos"/>
                            <ComboBoxItem Tag="0" Content="Entrada"/>
                            <ComboBoxItem Tag="1" Content="Salida"/>
                            <ComboBoxItem Tag="2" Content="Paso"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- TERMINAL dinámico (DescTerminal según Movimiento) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TERMINAL" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}"
                                  IsEnabled="{Binding TerminalEnabled}"
                                  ItemsSource="{Binding TerminalesDisponibles}"
                                  SelectedItem="{Binding TerminalSeleccionado, Mode=TwoWay}"
                                  IsEditable="False"
                                  ToolTip="Se carga según el Movimiento seleccionado"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="FIAB. MÍN." Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding MinConfidence, Mode=TwoWay}">
                            <ComboBoxItem Tag="0"  Content="0%"/>
                            <ComboBoxItem Tag="50" Content="50%"/>
                            <ComboBoxItem Tag="75" Content="75%"/>
                            <ComboBoxItem Tag="90" Content="90%"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="6" Style="{StaticResource BtnGhost}"
                            Content="Limpiar" VerticalAlignment="Bottom"
                            Command="{Binding ClearFiltersCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- META BAR -->
        <Border Grid.Row="3" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="18,8">
                <TextBlock Foreground="{DynamicResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11">
                    <Run Text="Resultados · "/>
                    <Run Text="{Binding TotalRecords, StringFormat=N0, Mode=OneWay}" Foreground="{DynamicResource Text0}"/>
                    <Run Text=" registros · página "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" Foreground="{DynamicResource Text0}"/>
                    <Run Text=" de "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" Foreground="{DynamicResource Text0}"/>
                </TextBlock>
                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11">
                    <Run Text="{Binding QueryTimeMs, Mode=OneWay}"/>
                    <Run Text=" ms"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ÁREA DE DATOS -->
        <Grid Grid.Row="4" Background="{DynamicResource Bg0}">

            <!-- ═══ DATAGRID HISTORICO ═══ -->
            <DataGrid x:Name="Grid"
                      Visibility="{Binding IsHistoricoMode, Converter={StaticResource BoolVis}}"
                      Style="{StaticResource GridStyle}"
                      CellStyle="{StaticResource GridCell}"
                      RowStyle="{StaticResource GridRow}"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      MouseDoubleClick="OnRowDoubleClick"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="80" SortMemberPath="NumeroLinea">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NumeroLinea, StringFormat={}{0:D6}}"
                                           Foreground="{DynamicResource Text3}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Matrícula" Width="150" SortMemberPath="Plate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlateFormatted}"
                                           Foreground="{DynamicResource Text0}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Fiab." Width="100" SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="4" CornerRadius="2"
                                            Background="{DynamicResource Bg3}" Margin="0,0,8,0">
                                        <Border HorizontalAlignment="Left"
                                                Height="4" CornerRadius="2"
                                                Width="{Binding Confidence, Converter={StaticResource ConfWidth}, ConverterParameter=40}"
                                                Background="{Binding Confidence, Converter={StaticResource ConfBrush}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"
                                               Foreground="{DynamicResource Text1}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Fecha / Hora" Width="180" SortMemberPath="FHGeneracion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DayText}"
                                               Foreground="{DynamicResource Text0}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                    <TextBlock Text="{Binding TimeText}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Text2}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Movimiento" Width="130" SortMemberPath="Movimiento">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        Background="{Binding MovementClass, Converter={StaticResource BadgeBg}}"
                                        BorderBrush="{Binding MovementClass, Converter={StaticResource BadgeFg}}">
                                    <TextBlock Text="{Binding Movimiento}"
                                               Foreground="{Binding MovementClass, Converter={StaticResource BadgeFg}}"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Terminal" Width="160" SortMemberPath="Terminal">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Terminal}"
                                           Foreground="{DynamicResource Text1}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tarjeta" Width="120" SortMemberPath="Tarjeta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tarjeta}"
                                           Foreground="{DynamicResource Text2}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Imágenes" Width="270" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Loaded="OnThumbnailLoaded">
                                    <Image Source="{Binding ThumbLeida}"
                                           Width="48" Height="38"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,4,0"
                                           Visibility="{Binding ThumbLeida, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding ThumbFrontal}"
                                           Width="48" Height="38"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,4,0"
                                           Visibility="{Binding ThumbFrontal, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding ThumbTrasera}"
                                           Width="48" Height="38"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,4,0"
                                           Visibility="{Binding ThumbTrasera, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding ThumbFacial}"
                                           Width="48" Height="38"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,4,0"
                                           Visibility="{Binding ThumbFacial, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding ThumbMatTras}"
                                           Width="48" Height="38"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ThumbMatTras, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconBtn}"
                                            Click="OnOpenViewerClick"
                                            ToolTip="Ver detalle (Doble click)">
                                        <TextBlock Text="◉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Click="OnCopyPlateClick"
                                            ToolTip="Copiar matrícula">
                                        <TextBlock Text="⧉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ExportSelectedRecordPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Exportar este registro a PDF (con imágenes)">
                                        <TextBlock Text="📄" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ═══ DATAGRID PRESENTES ═══ -->
            <DataGrid x:Name="GridPresentes"
                      Visibility="{Binding IsPresentesMode, Converter={StaticResource BoolVis}}"
                      Style="{StaticResource GridStyle}"
                      CellStyle="{StaticResource GridCell}"
                      RowStyle="{StaticResource GridRow}"
                      ColumnHeaderStyle="{StaticResource GridHeader}"
                      ItemsSource="{Binding PresentRows}"
                      SelectedItem="{Binding SelectedPresente, Mode=TwoWay}"
                      MouseDoubleClick="OnPresenteRowDoubleClick"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Matrícula" Width="150" SortMemberPath="Plate">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PlateFormatted}"
                                           Foreground="{DynamicResource Text0}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Fiab." Width="100" SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="4" CornerRadius="2"
                                            Background="{DynamicResource Bg3}" Margin="0,0,8,0">
                                        <Border HorizontalAlignment="Left"
                                                Height="4" CornerRadius="2"
                                                Width="{Binding Confidence, Converter={StaticResource ConfWidth}, ConverterParameter=40}"
                                                Background="{Binding Confidence, Converter={StaticResource ConfBrush}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"
                                               Foreground="{DynamicResource Text1}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Entrada" Width="180" SortMemberPath="FechaEntrada">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DayText}"
                                               Foreground="{DynamicResource Text0}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                    <TextBlock Text="{Binding TimeText}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Text2}"
                                               FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Terminal entrada" Width="180" SortMemberPath="TerminalEntrada">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TerminalEntrada}"
                                           Foreground="{DynamicResource Text1}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Tarjeta" Width="150" SortMemberPath="Tarjeta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Tarjeta}"
                                           Foreground="{DynamicResource Text2}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Id Tarjeta" Width="120" SortMemberPath="IdTarjeta">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IdTarjeta}"
                                           Foreground="{DynamicResource Text2}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Imágenes" Width="140" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Loaded="OnPresenteThumbnailLoaded">
                                    <Image Source="{Binding ThumbEntrada}"
                                           Width="52" Height="42"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="0,0,4,0"
                                           Visibility="{Binding ThumbEntrada, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                    <Image Source="{Binding ThumbTrasera}"
                                           Width="52" Height="42"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ThumbTrasera, Converter={StaticResource NullVis}, ConverterParameter=Invert}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="*" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconBtn}"
                                            Click="OnOpenPresenteViewerClick"
                                            ToolTip="Ver detalle (Doble click)">
                                        <TextBlock Text="◉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Click="OnCopyPresentePlateClick"
                                            ToolTip="Copiar matrícula">
                                        <TextBlock Text="⧉" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.ExportSelectedRecordPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Exportar este registro a PDF (con imágenes)">
                                        <TextBlock Text="📄" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                                 Background="{DynamicResource Bg2}"
                                 Foreground="{DynamicResource Accent}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0"
                               Foreground="{DynamicResource Text2}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PAGINACIÓN -->
        <Border Grid.Row="5" Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="18,10">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource Text2}"
                           FontFamily="{StaticResource FontMono}" FontSize="11"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="POR PÁGINA" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              MinWidth="80" Margin="0,0,12,0"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding PageSize, Mode=TwoWay}">
                        <ComboBoxItem Tag="50" Content="50"/>
                        <ComboBoxItem Tag="100" Content="100"/>
                        <ComboBoxItem Tag="250" Content="250"/>
                        <ComboBoxItem Tag="500" Content="500"/>
                    </ComboBox>

                    <Button Style="{StaticResource IconBtn}" Margin="0,0,4,0"
                            Command="{Binding FirstPageCommand}" Content="«" ToolTip="Primera"/>
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,8,0"
                            Command="{Binding PrevPageCommand}"  Content="‹" ToolTip="Anterior"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text0}"
                               FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,0,8,0">
                        <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource IconBtn}" Margin="0,0,4,0"
                            Command="{Binding NextPageCommand}" Content="›" ToolTip="Siguiente"/>
                    <Button Style="{StaticResource IconBtn}"
                            Command="{Binding LastPageCommand}" Content="»" ToolTip="Última"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
