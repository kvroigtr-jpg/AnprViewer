<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ TOKENS DE COLOR ═══════════════ -->
    <Color x:Key="Bg0Color">#FF0A0D12</Color>
    <Color x:Key="Bg1Color">#FF0F141B</Color>
    <Color x:Key="Bg2Color">#FF161D27</Color>
    <Color x:Key="Bg3Color">#FF1D2632</Color>
    <Color x:Key="BgHoverColor">#FF222D3A</Color>
    <Color x:Key="LineColor">#FF222B38</Color>
    <Color x:Key="LineSoftColor">#FF1A212C</Color>

    <Color x:Key="Text0Color">#FFE6EDF5</Color>
    <Color x:Key="Text1Color">#FFAAB4C2</Color>
    <Color x:Key="Text2Color">#FF6B7787</Color>
    <Color x:Key="Text3Color">#FF475063</Color>

    <Color x:Key="AccentColor">#FF5CF5D3</Color>
    <Color x:Key="AccentDimColor">#FF2A8A78</Color>

    <Color x:Key="OkColor">#FF5CF58A</Color>
    <Color x:Key="WarnColor">#FFF5B95C</Color>
    <Color x:Key="ErrColor">#FFFF6B6B</Color>
    <Color x:Key="InfoColor">#FF5CB8F5</Color>

    <SolidColorBrush x:Key="Bg0"        Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1"        Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Bg2"        Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="Bg3"        Color="{StaticResource Bg3Color}"/>
    <SolidColorBrush x:Key="BgHover"    Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="Line"       Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineSoft"   Color="{StaticResource LineSoftColor}"/>

    <SolidColorBrush x:Key="Text0"      Color="{StaticResource Text0Color}"/>
    <SolidColorBrush x:Key="Text1"      Color="{StaticResource Text1Color}"/>
    <SolidColorBrush x:Key="Text2"      Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3"      Color="{StaticResource Text3Color}"/>

    <SolidColorBrush x:Key="Accent"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentDim"  Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="AccentBg"   Color="#1A5CF5D3"/>

    <SolidColorBrush x:Key="Ok"         Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkBg"       Color="#205CF58A"/>
    <SolidColorBrush x:Key="Warn"       Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnBg"     Color="#20F5B95C"/>
    <SolidColorBrush x:Key="Err"        Color="{StaticResource ErrColor}"/>
    <SolidColorBrush x:Key="ErrBg"      Color="#20FF6B6B"/>
    <SolidColorBrush x:Key="Info"       Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoBg"     Color="#205CB8F5"/>

    <!-- ═══════════════ TIPOGRAFÍA ═══════════════ -->
    <FontFamily x:Key="FontUI">Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">JetBrains Mono, Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- ═══════════════ ESTILOS BASE ═══════════════ -->
    <Style TargetType="Window">
        <Setter Property="Background"       Value="{StaticResource Bg0}"/>
        <Setter Property="Foreground"       Value="{StaticResource Text0}"/>
        <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text1}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
    </Style>

</ResourceDictionary>
