<UserControl x:Class="AnprViewer.Controls.PlateBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border CornerRadius="6"
            BorderBrush="#FF111111"
            BorderThickness="2"
            Background="#FFF5F5F0">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="6"
                              Color="#000000" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Banda azul tipo placa UE -->
            <Border Grid.Column="0" CornerRadius="4,0,0,4" Background="#FF003399">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="★" Foreground="#FFFFCC00"
                               FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="E" Foreground="White"
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="{Binding Plate, ElementName=Root}"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       FontWeight="Bold" FontSize="20"
                       Foreground="#FF111111"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="6,6"
                       TextOptions.TextRenderingMode="ClearType"/>
        </Grid>
    </Border>
</UserControl>
