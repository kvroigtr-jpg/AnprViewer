<UserControl x:Class="AnprViewer.Controls.DateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource Bg2}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Fecha (DatePicker estándar, integrado con estilo de la app) -->
            <DatePicker Grid.Column="0"
                        x:Name="DatePart"
                        Style="{StaticResource InputDate}"
                        BorderThickness="0"
                        Background="Transparent"
                        SelectedDateChanged="OnDateChanged"/>

            <!-- Hora : Minuto : Segundo -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="6,0,4,0">
                <TextBox x:Name="HourBox"
                         Width="30"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Bg3}"
                         Foreground="{DynamicResource Text0}"
                         BorderBrush="{DynamicResource Line}"
                         BorderThickness="1"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="12"
                         PreviewTextInput="OnNumericInput"
                         TextChanged="OnTimePartChanged"
                         ToolTip="Hora (00-23)"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0"
                           Foreground="{DynamicResource Text2}"
                           FontFamily="{StaticResource FontMono}"/>
                <TextBox x:Name="MinuteBox"
                         Width="30"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Bg3}"
                         Foreground="{DynamicResource Text0}"
                         BorderBrush="{DynamicResource Line}"
                         BorderThickness="1"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="12"
                         PreviewTextInput="OnNumericInput"
                         TextChanged="OnTimePartChanged"
                         ToolTip="Minutos (00-59)"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0"
                           Foreground="{DynamicResource Text2}"
                           FontFamily="{StaticResource FontMono}"/>
                <TextBox x:Name="SecondBox"
                         Width="30"
                         MaxLength="2"
                         Text="00"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Bg3}"
                         Foreground="{DynamicResource Text0}"
                         BorderBrush="{DynamicResource Line}"
                         BorderThickness="1"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="12"
                         PreviewTextInput="OnNumericInput"
                         TextChanged="OnTimePartChanged"
                         ToolTip="Segundos (00-59)"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
