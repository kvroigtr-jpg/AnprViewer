<Window x:Class="AnprViewer.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AnprViewer.Converters"
        xmlns:ctrl="clr-namespace:AnprViewer.Controls"
        xmlns:vm="clr-namespace:AnprViewer.ViewModels"
        Title="Gestor Matrículas Extendida - Detalle del registro"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolVis"/>
        <conv:ImageKindToLabelConverter   x:Key="KindLabel"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Record.MatriculaLeida}"
                               Foreground="{StaticResource Accent}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text1}"
                               FontFamily="{StaticResource FontMono}" FontSize="12">
                        <Run Text="{Binding Record.FHGeneracion, StringFormat='dd/MM/yyyy HH:mm:ss', Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Text2}"
                               FontFamily="{StaticResource FontMono}" FontSize="12">
                        <Run Text="{Binding Record.TipoMovimientoDesc, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding Record.DescTerminal, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}"
                        Width="32" Height="32" FontSize="18"
                        Click="OnCloseClick" Content="×" ToolTip="Cerrar (Esc)"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg1}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding AvailableKinds}" Padding="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="4"
                                    Background="{StaticResource Bg2}"
                                    BorderThickness="2"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OnStripItemClick"
                                    Tag="{Binding}">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{conv:EqualsToAccentBrushConverter}">
                                        <Binding/>
                                        <Binding Path="DataContext.CurrentKind" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                                <Grid Height="90">
                                    <TextBlock Text="{Binding Converter={StaticResource KindLabel}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,6"
                                               Foreground="{StaticResource Text1}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10"
                                               TextOptions.TextRenderingMode="ClearType"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid Grid.Column="1">
                <ctrl:ZoomableImage x:Name="Zoomer"
                                    Source="{Binding CurrentImage}"/>

                <Border Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                                     Background="{StaticResource Bg2}"
                                     Foreground="{StaticResource Accent}"
                                     BorderThickness="0"/>
                        <TextBlock Text="Cargando imagen…" Margin="0,12,0,0"
                                   Foreground="{StaticResource Text2}"
                                   FontFamily="{StaticResource FontMono}" FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,18" Padding="6"
                        Background="#F00F141B"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32"
                                Click="OnZoomOut" Content="−" ToolTip="Alejar (−)"/>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32" Margin="4,0,0,0"
                                Click="OnFit" Content="⊡" ToolTip="Ajustar (0)"/>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32" Margin="4,0,0,0"
                                Click="OnZoomIn" Content="+" ToolTip="Acercar (+)"/>
                        <Border Width="64" Margin="4,0" BorderBrush="{StaticResource Line}" BorderThickness="1,0">
                            <TextBlock x:Name="ZoomLabel" Text="100%"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text1}"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"/>
                        </Border>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32"
                                Click="OnRotate" Content="↻" ToolTip="Rotar (R)"/>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32" Margin="4,0,0,0"
                                Click="OnPrevKind" Content="‹" ToolTip="Imagen anterior (←)"/>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32" Margin="4,0,0,0"
                                Click="OnNextKind" Content="›" ToolTip="Imagen siguiente (→)"/>
                        <Button Style="{StaticResource IconBtn}" Width="36" Height="32" Margin="4,0,0,0"
                                Click="OnSave" Content="↓" ToolTip="Guardar (D)"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource Bg1}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="REGISTRO" Style="{StaticResource FieldLabel}"
                                   FontSize="10" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NumeroLinea" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Record.NumeroLinea}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CodigoAparc." Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.CodigoAparcamiento}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="NumeroTerminal" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.NumeroTerminal}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="FHGeneracion" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Record.FHGeneracion, StringFormat='dd/MM/yyyy HH:mm:ss', Mode=OneWay}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="MATRÍCULA" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Leída" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Record.MatriculaLeida}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Operación" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.MatriculaOperacion}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Fiabilidad" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.FiabilidadMatricula, StringFormat='0.0', Mode=OneWay}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Nº fallos" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Record.NumeroDeFallos}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="MOVIMIENTO" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Record.TipoMovimientoDesc}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Terminal" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.DescTerminal}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipo terminal" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.TipoTerminalDesc}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="TARJETA" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Clase" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Record.DescClaseTarjeta}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.DescTipoTarjeta}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Código" Foreground="{StaticResource Text2}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.CodigoTarjeta}" Foreground="{StaticResource Text0}" FontFamily="{StaticResource FontMono}" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource Text3}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
