<Window x:Class="AnprViewer.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AnprViewer.Converters"
        Title="Gestor Matrículas Extendida - Conexión"
        Icon="pack://application:,,,/Resources/Images/app.ico"
        Width="520" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <conv:StatusKindToBrushConverter x:Key="StatusFg" />
        <conv:StatusKindToBrushConverter x:Key="StatusBg" Background="True"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <Border CornerRadius="10"
            Background="{StaticResource Bg1}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="Black" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═════════ TOPBAR con logo ═════════ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTopbarDrag">
                <Grid Margin="22,18,14,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo CAME PARKARE -->
                        <Image Source="pack://application:,,,/Resources/Images/logo.png"
                               Height="32" 
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border Width="1" Height="28"
                                Background="{StaticResource Line}"
                                Margin="14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Gestor Matrículas Extendida"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource Text0}"/>
                            <TextBlock Text="Configuración de conexión SQL Server"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="10"
                                       Foreground="{StaticResource Text2}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="28" Height="28"
                            Background="Transparent" Foreground="{StaticResource Text2}"
                            BorderThickness="0" FontSize="18"
                            Cursor="Hand" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- ═════════ FORMULARIO ═════════ -->
            <ScrollViewer Grid.Row="1" Padding="22,8,22,8" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SERVIDOR" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PUERTO" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="INSTANCIA (OPCIONAL · EJ: SQLEXPRESS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="BASE DE DATOS" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="AUTENTICACIÓN" Style="{StaticResource FieldLabel}"/>
                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" x:Name="RbSqlAuth" GroupName="Auth"
                                             Content="SQL Server" Padding="0,7"
                                             HorizontalContentAlignment="Center"
                                             Foreground="{StaticResource Text1}"
                                             Click="OnSqlAuthChecked"/>
                                <RadioButton Grid.Column="1" x:Name="RbWinAuth" GroupName="Auth"
                                             Content="Windows Auth" Padding="0,7"
                                             HorizontalContentAlignment="Center"
                                             Foreground="{StaticResource Text1}"
                                             IsChecked="{Binding IntegratedSecurity, Mode=TwoWay}"
                                             Click="OnWinAuthChecked"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IntegratedSecurity, Converter={StaticResource InvBoolVis}}">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="USUARIO" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PwdBox" Style="{StaticResource InputPwd}"/>
                        </StackPanel>
                    </StackPanel>

                    <Expander Header="Opciones avanzadas" Margin="0,4,0,8"
                              Foreground="{StaticResource Text2}"
                              FontFamily="{StaticResource FontMono}" FontSize="11">
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox Content="Encrypt connection"
                                      Foreground="{StaticResource Text1}"
                                      IsChecked="{Binding Encrypt}"/>
                            <CheckBox Content="Trust server certificate" Margin="0,6,0,0"
                                      Foreground="{StaticResource Text1}"
                                      IsChecked="{Binding TrustServerCertificate}"/>
                            <CheckBox Content="Recordar configuración (sin contraseña)" Margin="0,6,0,0"
                                      Foreground="{StaticResource Text1}"
                                      IsChecked="{Binding RememberSettings}"/>
                        </StackPanel>
                    </Expander>

                    <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="5"
                            BorderThickness="1"
                            Background="{Binding StatusKind, Converter={StaticResource StatusBg}}"
                            BorderBrush="{Binding StatusKind, Converter={StaticResource StatusFg}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusFg}}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═════════ FOOTER ═════════ -->
            <Border Grid.Row="2" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource BtnGhost}"
                            Content="Probar conexión"
                            Command="{Binding TestCommand}"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource BtnPrimary}"
                            Content="Conectar a SQL Server"
                            Command="{Binding ConnectCommand}"
                            MinWidth="180"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
